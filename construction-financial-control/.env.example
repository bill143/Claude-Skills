# Copy to .env and adjust. Defaults in app/core/config.py are DEV-ONLY.
# In ENVIRONMENT=prod the app REFUSES to start with: default/short SECRET_KEY,
# DEBUG=true, wildcard/empty CORS_ORIGINS, SQLite DATABASE_URL, or
# AUTO_CREATE_TABLES (forced off outside dev).

# --- Environment profile: dev | stage | prod ---
ENVIRONMENT=dev
DEBUG=false

# --- Security ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=generate-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Explicit comma-separated allowlist; never "*" in stage/prod.
CORS_ORIGINS=http://localhost:8501

# --- Database (PostgreSQL required for stage/prod) ---
DATABASE_URL=postgresql+psycopg2://cfcs:cfcs@localhost:5432/cfcs

# --- Redis / Celery (only needed for the optional worker) ---
REDIS_URL=redis://localhost:6379/0
READINESS_CHECK_REDIS=false

# --- Budget control ---
# Fractional tolerance before STOP/WARN fires on PO submission (0.05 = 5%)
BUDGET_TOLERANCE_PCT=0.0

# --- Schema management ---
# Alembic owns the schema: alembic upgrade head. Dev-only shortcut:
AUTO_CREATE_TABLES=false

# --- Observability ---
LOG_LEVEL=INFO
LOG_JSON=true

# --- Rate limiting (per instance) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_MUTATING_PER_MINUTE=120
RATE_LIMIT_DEFAULT_PER_MINUTE=300

# --- Streamlit ---
API_BASE_URL=http://localhost:8000
