# Copy to .env and adjust. All values have safe dev defaults in app/core/config.py.

# --- Security ---
SECRET_KEY=generate-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Database ---
DATABASE_URL=postgresql+psycopg2://cfcs:cfcs@localhost:5432/cfcs

# --- Redis / Celery (only needed for the optional worker) ---
REDIS_URL=redis://localhost:6379/0

# --- Budget control ---
# Fractional tolerance before STOP/WARN fires on PO submission (0.05 = 5%)
BUDGET_TOLERANCE_PCT=0.0

# --- Dev convenience (set false in production; use Alembic) ---
AUTO_CREATE_TABLES=true

# --- Streamlit ---
API_BASE_URL=http://localhost:8000
